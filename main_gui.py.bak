import tkinter as tk
from tkinter import messagebox, ttk, filedialog, Toplevel
import threading
import time
import subprocess
import pyautogui
from pynput import keyboard
from screen_capture_tool import ScreenCaptureTool
from PIL import Image, ImageTk
import os
import json
import shutil

# --- 데이터 모델 및 유틸 ---
class ActionUtils:
    @staticmethod
    def resolve_path(base_dir, path):
        if not path: return ""
        if os.path.exists(path): return path
        new_path = os.path.join(base_dir, path)
        if os.path.exists(new_path): return new_path
        if "images" in path:
            filename = os.path.basename(path)
            fixed_path = os.path.join(base_dir, "images", filename)
            if os.path.exists(fixed_path): return fixed_path
        return path

# --- 통합 설정 팝업 클래스 ---
class ActionEditor(Toplevel):
    def __init__(self, parent, action_data=None, is_child=False, on_save=None, capture_tool=None):
        super().__init__(parent)
        self.title("동작 설정")
        self.geometry("450x450")
        self.resizable(False, False)
        self.parent = parent
        self.on_save = on_save
        self.capture_tool = capture_tool
        
        self.result_data = None
        
        # 기본값
        self.name_var = tk.StringVar(value=action_data.get('name', '새 동작') if action_data else '새 동작')
        self.type_var = tk.StringVar(value=action_data.get('type', 'normal') if action_data else ('child' if is_child else 'normal'))
        self.image_path_var = tk.StringVar(value=action_data.get('image_path', '') if action_data else '')
        self.delay_var = tk.DoubleVar(value=action_data.get('delay', 1.0) if action_data else 1.0)
        self.cooldown_var = tk.DoubleVar(value=action_data.get('cooldown', 0.0) if action_data else 0.0)
        
        self.is_editing = action_data is not None
        self.is_child_mode = is_child

        self._create_ui()

    def _create_ui(self):
        body = tk.Frame(self, padx=10, pady=10)
        body.pack(fill=tk.BOTH, expand=True)

        # 1. 이름
        tk.Label(body, text="이름:").grid(row=0, column=0, sticky="w", pady=5)
        tk.Entry(body, textvariable=self.name_var, width=30).grid(row=0, column=1, sticky="ew")

        # 2. 타입 (일반 / 감시자) - 하위 동작일 경우 고정
        tk.Label(body, text="타입:").grid(row=1, column=0, sticky="w", pady=5)
        type_frame = tk.Frame(body)
        type_frame.grid(row=1, column=1, sticky="w")
        
        if self.is_child_mode:
            tk.Label(type_frame, text="하위 동작 (Child)").pack(side=tk.LEFT)
            self.type_var.set('child')
        else:
            tk.Radiobutton(type_frame, text="일반 동작", variable=self.type_var, value="normal").pack(side=tk.LEFT)
            tk.Radiobutton(type_frame, text="감시자 (Watcher)", variable=self.type_var, value="watcher").pack(side=tk.LEFT)

        # 3. 이미지
        tk.Label(body, text="이미지:").grid(row=2, column=0, sticky="nw", pady=5)
        img_frame = tk.Frame(body)
        img_frame.grid(row=2, column=1, sticky="w")
        
        self.path_entry = tk.Entry(img_frame, textvariable=self.image_path_var, width=20, state='readonly')
        self.path_entry.pack(side=tk.LEFT, fill=tk.X)
        
        btn_frame = tk.Frame(img_frame)
        btn_frame.pack(side=tk.LEFT, padx=5)
        tk.Button(btn_frame, text="캡처", command=self._capture_image, bg="#e3f2fd").pack(fill=tk.X, pady=1)
        tk.Button(btn_frame, text="파일 찾기", command=self._browse_file).pack(fill=tk.X, pady=1)

        # 4. 시간 설정
        tk.Label(body, text="후딜레이(초):").grid(row=3, column=0, sticky="w", pady=5)
        tk.Entry(body, textvariable=self.delay_var, width=10).grid(row=3, column=1, sticky="w")
        
        tk.Label(body, text="쿨타임(초):").grid(row=4, column=0, sticky="w", pady=5)
        tk.Entry(body, textvariable=self.cooldown_var, width=10).grid(row=4, column=1, sticky="w")

        # 설명
        info_text = "※ 감시자(Watcher)는 발견 시 하위 동작들을 실행합니다.\n※ 일반 동작은 발견 시 클릭하고 넘어갑니다."
        tk.Label(body, text=info_text, fg="gray", justify=tk.LEFT).grid(row=5, column=0, columnspan=2, pady=10)

        # 하단 버튼
        btn_area = tk.Frame(self, pady=10)
        btn_area.pack(fill=tk.X, side=tk.BOTTOM)
        tk.Button(btn_area, text="취소", command=self.destroy).pack(side=tk.RIGHT, padx=10)
        tk.Button(btn_area, text="확인", command=self._on_ok, bg="#c8e6c9").pack(side=tk.RIGHT, padx=10)

    def _capture_image(self):
        self.withdraw() # 팝업 숨김
        # 캡처 툴 콜백
        def on_captured(name, path, delay): # delay는 무시 (여기서 설정하므로)
            self.deiconify() # 팝업 복귀
            self.image_path_var.set(path)
            # 이름이 비어있으면 캡처된 이름으로, 아니면 유지
            if self.name_var.get() == "새 동작" or not self.name_var.get():
                self.name_var.set(name)
        
        self.capture_tool.on_image_selected = on_captured
        self.capture_tool.capture_and_select()

    def _browse_file(self):
        path = filedialog.askopenfilename(filetypes=[("Images", "*.png *.jpg")])
        if path:
            # 프로젝트 폴더로 복사 로직은 여기서 생략하거나 메인에서 처리 (여기선 경로만)
            self.image_path_var.set(path)

    def _on_ok(self):
        data = {
            "name": self.name_var.get(),
            "type": self.type_var.get(),
            "image_path": self.image_path_var.get(),
            "delay": self.delay_var.get(),
            "cooldown": self.cooldown_var.get(),
            "last_run": 0.0,
            "children": [] # 새 감시자일 경우 자식 리스트 초기화
        }
        if self.on_save:
            self.on_save(data)
        self.destroy()


# --- 메인 애플리케이션 ---
class MacroApp:
    def __init__(self, root):
        self.root = root
        self.root.title("블루스택 터치 매크로 Pro (Tree Ver)")
        self.root.geometry("1100x800")
        
        self.base_dir = os.path.dirname(os.path.abspath(__file__))

        self.macro_running = False
        self.macro_thread = None
        self.error_monitor_thread = None
        self.listener = None
        
        # 데이터: 트리 구조 [{... children:[]}, ...]
        self.action_tree = [] 
        self.error_watchers = [] # 에러 감시자 리스트 (별도 관리)
        
        # 에러 감시 설정
        self.error_check_interval = 10.0 # 주기 (초)
        self.error_check_duration = 2.0  # 스캔 시간

        self.selected_app_name = tk.StringVar()
        self.execution_mode = tk.StringVar(value="sequential") 
        self.preview_image_ref = None 

        # 캡처 툴 초기화 (콜백은 그때그때 설정)
        self.screen_capture_tool = ScreenCaptureTool(self.root, None)
        
        pyautogui.FAILSAFE = False 

        self._create_widgets()
        self._start_keyboard_listener()
        self._load_profile_list()

    # --- UI 구성 ---
    def _create_widgets(self):
        # 1. 상단 (앱선택, 모드)
        top = tk.LabelFrame(self.root, text="기본 설정")
        top.pack(fill=tk.X, padx=5, pady=5)
        
        tk.Label(top, text="대상 앱:").pack(side=tk.LEFT)
        self.app_combo = ttk.Combobox(top, textvariable=self.selected_app_name, width=15)
        self.app_combo['values'] = self._get_running_apps()
        if self.app_combo['values']: self.app_combo.current(0)
        self.app_combo.pack(side=tk.LEFT)
        tk.Button(top, text="↻", command=self._refresh_app_list, width=2).pack(side=tk.LEFT)
        
        tk.Label(top, text="| 실행 모드:").pack(side=tk.LEFT, padx=10)
        tk.Radiobutton(top, text="순차 실행", variable=self.execution_mode, value="sequential").pack(side=tk.LEFT)
        tk.Radiobutton(top, text="발견 즉시", variable=self.execution_mode, value="any").pack(side=tk.LEFT)
        
        tk.Button(top, text="⚙️ 에러 감시 설정", command=self._open_error_settings, bg="#fff9c4").pack(side=tk.RIGHT, padx=5)

        # 2. 메인 (좌: 트리, 우: 패널)
        main = tk.Frame(self.root)
        main.pack(fill=tk.BOTH, expand=True, padx=5)
        
        left = tk.LabelFrame(main, text="동작 시퀀스 (트리)")
        left.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        # Treeview
        self.tree = ttk.Treeview(left, columns=("Type", "Delay", "Cooldown"), selectmode="browse")
        self.tree.heading("#0", text="이름 (계층 구조)")
        self.tree.heading("Type", text="타입")
        self.tree.heading("Delay", text="후딜")
        self.tree.heading("Cooldown", text="쿨타임")
        
        self.tree.column("#0", width=250)
        self.tree.column("Type", width=80, anchor="center")
        self.tree.column("Delay", width=60, anchor="center")
        self.tree.column("Cooldown", width=60, anchor="center")
        
        self.tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        self.tree.bind("<<TreeviewSelect>>", self._on_tree_select)
        self.tree.bind("<Double-1>", lambda e: self._edit_selected())
        
        scroll = ttk.Scrollbar(left, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=scroll.set)
        scroll.pack(side=tk.RIGHT, fill=tk.Y)

        right = tk.Frame(main)
        right.pack(side=tk.RIGHT, fill=tk.Y, padx=5)

        # 프리뷰
        prev = tk.LabelFrame(right, text="미리보기", width=220, height=150)
        prev.pack(fill=tk.X)
        prev.pack_propagate(False)
        self.preview_label = tk.Label(prev, text="No Image")
        self.preview_label.pack(expand=True)

        # 버튼들
        edit = tk.LabelFrame(right, text="편집")
        edit.pack(fill=tk.X, pady=5)
        
        tk.Button(edit, text="➕ 루트 동작 추가", command=lambda: self._open_editor(is_child=False), bg="#e1f5fe").pack(fill=tk.X, pady=2)
        tk.Button(edit, text="↳ 하위 동작 추가", command=lambda: self._open_editor(is_child=True)).pack(fill=tk.X, pady=2)
        tk.Button(edit, text="✏️ 선택 편집", command=self._edit_selected).pack(fill=tk.X, pady=2)
        tk.Button(edit, text="➖ 삭제", command=self._delete_selected).pack(fill=tk.X, pady=2)
        
        tk.Frame(edit, height=5).pack()
        tk.Button(edit, text="⬆ 위로", command=self._move_up).pack(fill=tk.X)
        tk.Button(edit, text="⬇ 아래로", command=self._move_down).pack(fill=tk.X)

        # 3. 하단
        bot = tk.Frame(self.root)
        bot.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)
        
        # 프로필
        prof = tk.LabelFrame(bot, text="프로필")
        prof.pack(fill=tk.X)
        self.profile_combo = ttk.Combobox(prof, width=20, state="readonly")
        self.profile_combo.pack(side=tk.LEFT, padx=5)
        tk.Button(prof, text="불러오기", command=self._load_profile_btn).pack(side=tk.LEFT)
        tk.Button(prof, text="저장", command=self._save_profile_btn).pack(side=tk.LEFT)
        
        # 실행
        run = tk.Frame(bot)
        run.pack(fill=tk.X, pady=5)
        self.start_btn = tk.Button(run, text="▶ 시작", command=self.start_macro, bg="#c8e6c9", font=("bold", 14))
        self.start_btn.pack(side=tk.LEFT, fill=tk.X, expand=True)
        self.stop_btn = tk.Button(run, text="⏹ 정지 (ESC)", command=self.stop_macro, bg="#ffcdd2", font=("bold", 14), state=tk.DISABLED)
        self.stop_btn.pack(side=tk.LEFT, fill=tk.X, expand=True)
        
        # 로그
        log_f = tk.LabelFrame(bot, text="로그")
        log_f.pack(fill=tk.BOTH, expand=True)
        self.log_text = tk.Text(log_f, height=6, state=tk.DISABLED)
        self.log_text.pack(fill=tk.BOTH, expand=True)

    # --- 로직 구현 ---
    def _open_editor(self, is_child=False, action_data=None):
        target_app = self.selected_app_name.get()
        if target_app: self._activate_app(target_app)

        if is_child:
            selected = self.tree.selection()
            if not selected:
                messagebox.showwarning("주의", "하위 동작을 추가할 상위 감시자(Watcher)를 선택해주세요.")
                return
            # 선택된 아이템이 감시자인지 확인 로직 필요하지만 일단 패스
        
        def save_callback(data):
            if action_data: # 수정
                # 기존 데이터 업데이트
                action_data.update(data)
                self._refresh_tree()
                self._log(f"수정 완료: {data['name']}")
            else: # 추가
                if is_child:
                    # 선택된 부모 찾기
                    sel_id = self.tree.selection()[0]
                    parent_node = self._find_node_by_id(sel_id)
                    if parent_node:
                        if 'children' not in parent_node: parent_node['children'] = []
                        parent_node['children'].append(data)
                else:
                    self.action_tree.append(data)
                self._refresh_tree()
                self._log(f"추가 완료: {data['name']}")

        ActionEditor(self.root, action_data, is_child, save_callback, self.screen_capture_tool)

    def _edit_selected(self):
        selected = self.tree.selection()
        if not selected: return
        node = self._find_node_by_id(selected[0])
        if node:
            self._open_editor(is_child=(node.get('type')=='child'), action_data=node)

    def _delete_selected(self):
        selected = self.tree.selection()
        if not selected: return
        if not messagebox.askyesno("삭제", "정말 삭제하시겠습니까?"): return
        
        # 트리에서 해당 노드 찾아 삭제 (재귀적 탐색 필요)
        self._delete_node_recursive(self.action_tree, selected[0])
        self._refresh_tree()

    def _delete_node_recursive(self, nodes, target_id):
        for i, node in enumerate(nodes):
            if str(id(node)) == target_id:
                del nodes[i]
                return True
            if 'children' in node:
                if self._delete_node_recursive(node['children'], target_id):
                    return True
        return False

    def _find_node_by_id(self, target_id):
        # Treeview item id를 객체 메모리 주소(str(id(obj)))로 매핑하여 사용
        def search(nodes):
            for node in nodes:
                if str(id(node)) == target_id: return node
                if 'children' in node:
                    res = search(node['children'])
                    if res: return res
            return None
        return search(self.action_tree)

    def _refresh_tree(self):
        self.tree.delete(*self.tree.get_children())
        
        def insert_nodes(nodes, parent_id=""):
            for node in nodes:
                node_id = str(id(node)) # 고유 ID로 객체 주소 사용
                text = node['name']
                type_str = "감시자" if node['type'] == 'watcher' else ("하위" if node['type'] == 'child' else "일반")
                
                self.tree.insert(parent_id, "end", iid=node_id, text=text, values=(type_str, node['delay'], node.get('cooldown',0)), open=True)
                
                if 'children' in node and node['children']:
                    insert_nodes(node['children'], node_id)

        insert_nodes(self.action_tree)

    def _on_tree_select(self, event):
        selected = self.tree.selection()
        if not selected: return
        node = self._find_node_by_id(selected[0])
        if node:
            path = ActionUtils.resolve_path(self.base_dir, node['image_path'])
            try:
                img = Image.open(path)
                img.thumbnail((200, 130))
                self.preview_image_ref = ImageTk.PhotoImage(img)
                self.preview_label.config(image=self.preview_image_ref, text="")
            except:
                self.preview_label.config(image='', text="No Image")

    def _move_up(self):
        # 순서 이동 (복잡해서 일단 생략하거나 루트 레벨만 지원)
        pass 
    def _move_down(self):
        pass

    # --- 에러 감시자 ---
    def _open_error_settings(self):
        # 에러 감시자 관리 팝업 (간소화)
        win = Toplevel(self.root)
        win.title("에러 감시 설정")
        win.geometry("400x300")
        
        tk.Label(win, text="에러 감시 주기(초):").pack()
        int_var = tk.Entry(win)
        int_var.insert(0, str(self.error_check_interval))
        int_var.pack()
        
        tk.Label(win, text="등록된 에러 이미지:").pack()
        lst = tk.Listbox(win)
        lst.pack(fill=tk.BOTH, expand=True)
        for w in self.error_watchers: lst.insert(tk.END, w['name'])
        
        def add_err():
            # 캡처 툴 호출 로직 (ActionEditor 재활용 가능하지만 간단히 구현)
            self._log("에러 이미지 추가는 메인 편집기와 유사하게 구현 필요")
            messagebox.showinfo("안내", "이 기능은 ActionEditor를 통해 '에러타입'을 추가하는 식으로 확장 가능합니다.\n현재는 데모입니다.")

        tk.Button(win, text="추가 (미구현)", command=add_err).pack()

    # --- 실행 로직 ---
    def start_macro(self):
        self.macro_running = True
        self._update_ui_state()
        self.macro_thread = threading.Thread(target=self._run_macro_loop)
        self.macro_thread.daemon = True
        self.macro_thread.start()
        
        # 에러 감시 스레드 시작
        self.error_monitor_thread = threading.Thread(target=self._run_error_monitor)
        self.error_monitor_thread.daemon = True
        self.error_monitor_thread.start()

    def stop_macro(self):
        self.macro_running = False
        self._update_ui_state()

    def _run_macro_loop(self):
        self._log(f"매크로 시작 ({self.execution_mode.get()})")
        
        while self.macro_running:
            mode = self.execution_mode.get()
            
            if mode == "sequential":
                self._run_sequential_recursive(self.action_tree)
            else:
                self._run_any_recursive(self.action_tree)
            
            time.sleep(0.5)
            
        self._log("매크로 종료")
        self.root.after(0, self._update_ui_state)

    def _run_sequential_recursive(self, nodes):
        for node in nodes:
            if not self.macro_running: return
            
            # 쿨타임 체크
            if self._is_cooldown(node): continue

            if node['type'] == 'watcher':
                # 감시자: 발견 시 하위 실행, 미발견 시 패스
                if self._find_and_click(node, click=False): # 클릭 안하고 찾기만
                    self._log(f"[감시자 발동] {node['name']}")
                    self._run_sequential_recursive(node.get('children', []))
                else:
                    pass # 감시자 조건 안맞으면 하위 실행 안함
            
            else: # normal or child
                # 일반: 발견할 때까지 대기 (순차 모드니까)
                # 단, 여기서 타임아웃을 두어 에러 감시자가 끼어들 틈을 줌 (스레드 방식이라 자동)
                found = False
                retry = 0
                while self.macro_running and not found and retry < 5: # 5초 대기 예시
                    if self._find_and_click(node):
                        found = True
                        time.sleep(node['delay'])
                    else:
                        time.sleep(1)
                        retry += 1
                
                if not found:
                    self._log(f" -> [스킵/미발견] {node['name']}")

    def _run_any_recursive(self, nodes):
        # 발견 즉시 모드: 리스트 전체를 훑어서 발견되는 것 실행
        # 트리 구조이므로 재귀적으로 싹 훑음
        for node in nodes:
            if not self.macro_running: return

            if self._is_cooldown(node): continue
            
            if node['type'] == 'watcher':
                if self._find_and_click(node, click=False):
                    self._log(f"[감시자 발동] {node['name']}")
                    self._run_any_recursive(node.get('children', []))
                    return # 실행했으면 다시 처음부터 (우선순위)
            else:
                if self._find_and_click(node):
                    time.sleep(node['delay'])
                    return # 실행했으면 다시 처음부터

    def _run_error_monitor(self):
        while self.macro_running:
            time.sleep(self.error_check_interval)
            # 에러 감시자 리스트 스캔
            for err_node in self.error_watchers:
                if self._find_and_click(err_node):
                    self._log(f"🚨 [에러 감지] {err_node['name']} 해결 중...")
                    time.sleep(1)

    # --- 헬퍼 ---
    def _is_cooldown(self, node):
        cd = node.get('cooldown', 0)
        last = node.get('last_run', 0)
        if cd > 0 and (time.time() - last < cd): return True
        return False

    def _find_and_click(self, node, click=True):
        path = ActionUtils.resolve_path(self.base_dir, node['image_path'])
        try:
            loc = pyautogui.locateCenterOnScreen(path, confidence=0.8, grayscale=True)
            if loc:
                if click:
                    self._click(loc)
                    node['last_run'] = time.time()
                return True
        except:
            pass
        return False

    def _click(self, loc):
        x, y = loc
        pyautogui.click(int(x/2), int(y/2)) # 좌표 보정 유지

    # --- 프로필 저장/로드 ---
    def _save_profile_btn(self):
        name = self.profile_combo.get()
        if not name: 
            name = simpledialog.askstring("저장", "프로필 이름:")
        if name:
            path = os.path.join(self.base_dir, "profiles", f"{name}.json")
            data = {
                "execution_mode": self.execution_mode.get(),
                "tree": self.action_tree,
                "error_watchers": self.error_watchers
            }
            with open(path, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=4, ensure_ascii=False)
            self._log(f"저장 완료: {name}")
            self._load_profile_list()

    def _load_profile_btn(self):
        name = self.profile_combo.get()
        if not name: return
        path = os.path.join(self.base_dir, "profiles", f"{name}.json")
        if os.path.exists(path):
            with open(path, "r", encoding="utf-8") as f:
                data = json.load(f)
            self.action_tree = data.get("tree", [])
            self.error_watchers = data.get("error_watchers", [])
            self.execution_mode.set(data.get("execution_mode", "sequential"))
            self._refresh_tree()
            self._log("로드 완료")

    def _load_profile_list(self):
        d = os.path.join(self.base_dir, "profiles")
        if not os.path.exists(d): os.makedirs(d)
        fs = [f.replace(".json","") for f in os.listdir(d) if f.endswith(".json")]
        self.profile_combo['values'] = sorted(fs)

    def _get_running_apps(self):
        return [] # 생략 (기존 코드 동일)
    def _activate_app(self, name):
        pass # 생략 (기존 코드 동일)
    def _refresh_app_list(self):
        pass
    def _start_keyboard_listener(self):
        self.listener = keyboard.Listener(on_press=lambda k: self.stop_macro() if k==keyboard.Key.esc else None)
        self.listener.start()
    def _update_ui_state(self):
        s = tk.NORMAL if not self.macro_running else tk.DISABLED
        self.start_btn.config(state=s)
        self.stop_btn.config(state=tk.NORMAL if self.macro_running else tk.DISABLED)
    def _log(self, msg):
        self.log_text.config(state=tk.NORMAL)
        self.log_text.insert(tk.END, f"{msg}\n")
        self.log_text.see(tk.END)
        self.log_text.config(state=tk.DISABLED)

if __name__ == "__main__":
    root = tk.Tk()
    app = MacroApp(root)
    root.mainloop()